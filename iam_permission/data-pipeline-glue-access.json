{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "S3FullAccess",
			"Effect": "Allow",
			"Action": [
				"s3:GetObject",
				"s3:PutObject",
				"s3:ListBucket",
				"s3:DeleteObject"
			],
			"Resource": [
				"arn:aws:s3:::bronze-bucket-tapasya/*",
				"arn:aws:s3:::bronze-bucket-tapasya",
				"arn:aws:s3:::silver-bucket-tapasya/*",
				"arn:aws:s3:::silver-bucket-tapasya",
				"arn:aws:s3:::gold-bucket-tapasya/*",
				"arn:aws:s3:::gold-bucket-tapasya",
				"arn:aws:s3:::tapasya-yt-data-pipeline-script/*",
				"arn:aws:s3:::tapasya-yt-data-pipeline-script"
			]
		}
	]
}